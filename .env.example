# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5174

# MongoDB (users, refresh tokens, chat sessions, messages).
# The deployment is a **standalone** server, not a replica set — there are no
# transactions and no session guarantees, so nothing in the codebase may rely
# on them. `directConnection=true` keeps the driver from negotiating a replica
# set it cannot find.
MONGO_URI=mongodb://localhost:27018/rag_ts?directConnection=true

# MongoDB corpus (papers, chunks, source objects, world tree, mining artefacts).
# Separate database from the application data — the corpus is written in bulk
# by the ingest jobs and has a very different access profile.
MONGO_CORPUS_URI=
MONGO_CORPUS_DB=rag_ts_corpus

# Qdrant (read only — written by the UTH pipeline)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=scientific_papers_gold

# JWT (each at least 32 characters)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Embedding (Hugging Face id or local directory)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# LLM (node-llama-cpp)
MODEL_PATH=../model/qwen2.5-7b-instruct-q4_k_m.gguf
LLM_GPU=auto
LLM_MAX_QUEUE=8
LLM_CONCURRENCY=1
LLM_TIMEOUT_MS=60000

# Files exported by the UTH pipeline
WORLD_DATA_DIR=../data/world
MINING_DIR=../data/gold/mining

# MinIO (S3-compatible) — Bronze raw artefacts and Silver Parquet.
# The region is only needed so the SDK can sign requests; MinIO ignores its
# value, so `auto` is the convention for S3-compatible stores.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=<your key>
MINIO_SECRET_KEY=<your secret>
MINIO_BUCKET_NAME=uth-scientific-lakehouse
MINIO_REGION=auto
