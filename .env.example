# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5174
# Reverse proxies really in front of the app (Cloudflare Tunnel, nginx...). 0 = X-Forwarded-For is
# ignored. Too high lets clients forge their IP; too low makes every client share one rate limit.
TRUST_PROXY_HOPS=0

# MongoDB (users, refresh tokens, chat sessions, messages)
MONGO_URI=mongodb://<app user>:<password>@localhost:27018/rag_ts?authSource=admin&replicaSet=rs0&directConnection=true

# docker compose: MongoDB of the app, with authentication and bound to loopback
RAGTS_MONGO_ROOT_USER=ragts_root
RAGTS_MONGO_ROOT_PASSWORD=<openssl rand -hex 24>
RAGTS_MONGO_APP_USER=ragts_app
RAGTS_MONGO_APP_PASSWORD=<openssl rand -hex 24>
RAGTS_MONGO_KEY=<openssl rand -base64 96, on one line>

# Qdrant (read only — written by the UTH pipeline)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=scientific_papers_gold

# JWT (each at least 32 characters)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Embedding (Hugging Face id or local directory)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# LLM (node-llama-cpp)
MODEL_PATH=../model/qwen2.5-7b-instruct-q4_k_m.gguf
LLM_GPU=auto
LLM_MAX_QUEUE=8
LLM_CONCURRENCY=1
LLM_TIMEOUT_MS=60000

# Files exported by the UTH pipeline
WORLD_DATA_DIR=../data/world
MINING_DIR=../data/gold/mining
