        <mxCell id="v15" value="&lt;b&gt;Cấu hình dev hiện tại&lt;/b&gt;&lt;br&gt;Intel Core Ultra 5 · iGPU Intel Arc · RAM 15,5 GB&lt;br&gt;LLM_SEQUENCES=1 · context 4096 · tối đa 512 token&lt;br&gt;&lt;br&gt;&lt;b&gt;Chưa có:&lt;/b&gt; đăng nhập, lưu lịch sử chat phía server, cache, stream token, metrics / tracing, hàng đợi LLM" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=8;shape=note;size=14;fillColor=#fffbe6;strokeColor=#b3a369;" parent="1" vertex="1">
