<mxfile host="drawio" agent="Claude Code" version="24.0.0">
  <diagram id="02-luong-cau-hoi-hien-tai" name="02 Luồng 1 câu hỏi (hiện tại)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1830" pageHeight="800" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;② Luồng xử lý MỘT câu hỏi trong monolith hiện tại&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1750" height="36" as="geometry"/></mxCell>
        <mxCell id="v2" value="Mọi bước chạy tuần tự trong cùng một tiến trình Node. Ô đỏ = bug / rủi ro (mã B-xx theo MICROSERVICE_ARCHITECTURE.md §0.2)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1750" height="26" as="geometry"/></mxCell>
        <mxCell id="v3" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;proxy Next.js gửi&lt;br&gt;POST /api/rag/chat&lt;br&gt;{ query, top_k, … }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="165" height="120" as="geometry"/></mxCell>
        <mxCell id="v4" value="&lt;b&gt;RagController&lt;/b&gt;&lt;br&gt;ValidationPipe kiểm QueryDto&lt;br&gt;(top_k 1–20, mặc định 5)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="238" y="180" width="165" height="120" as="geometry"/></mxCell>
        <mxCell id="v5" value="&lt;b&gt;① Mở rộng query&lt;/b&gt;&lt;br&gt;(chỉ khi expand_query)&lt;br&gt;luật FP-Growth trong RAM&lt;br&gt;&lt;i&gt;CPU · rất nhanh&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="436" y="180" width="165" height="120" as="geometry"/></mxCell>
        <mxCell id="v6" value="&lt;b&gt;② Embed&lt;/b&gt;&lt;br&gt;nomic v1.5 → vector 768-D&lt;br&gt;&lt;i&gt;CPU · chạy trên event loop&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="634" y="180" width="165" height="120" as="geometry"/></mxCell>
        <mxCell id="v7" value="&lt;b&gt;③ Tìm vector&lt;/b&gt;&lt;br&gt;LanceDB cosine&lt;br&gt;lấy max(top_k×3, 20)&lt;br&gt;&lt;i&gt;đĩa local hoặc R2&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="832" y="180" width="165" height="120" as="geometry"/></mxCell>
        <mxCell id="v8" value="&lt;b&gt;④ Rerank&lt;/b&gt;&lt;br&gt;0.85 × sim + 0.15 × authority&lt;br&gt;cắt còn top_k&lt;br&gt;&lt;i&gt;CPU&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1030" y="180" width="165" height="120" as="geometry"/></mxCell>
        <mxCell id="v9" value="&lt;b&gt;⑤ Prompt + LLM&lt;/b&gt;&lt;br&gt;ghép chunk vào prompt&lt;br&gt;Qwen 0.5B sinh câu trả lời&lt;br&gt;&lt;i&gt;CPU/GPU · CHẬM NHẤT&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1228" y="180" width="165" height="120" as="geometry"/></mxCell>
        <mxCell id="v10" value="&lt;b&gt;⑥ Trích citation&lt;/b&gt;&lt;br&gt;regex [Paper: id], [n], …&lt;br&gt;&lt;i&gt;CPU&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1426" y="180" width="165" height="120" as="geometry"/></mxCell>
        <mxCell id="v11" value="&lt;b&gt;Response JSON&lt;/b&gt;&lt;br&gt;query · answer · citations&lt;br&gt;grounded_chunks · latency_ms&lt;br&gt;trả &lt;b&gt;1 lần&lt;/b&gt; khi xong hết" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1624" y="180" width="165" height="120" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v20" value="&lt;b&gt;Request #2 đến cùng lúc&lt;/b&gt;&lt;br&gt;không có hàng đợi → lỗi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1228" y="100" width="165" height="55" as="geometry"/></mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v20" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v22" value="&lt;b&gt;B-12&lt;/b&gt; Health luôn trả &quot;ok&quot; dù LLM / dữ liệu hỏng&lt;br&gt;&lt;br&gt;&lt;b&gt;B-18&lt;/b&gt; Ghi log nguyên văn câu hỏi của người dùng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;spacingRight=6;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="238" y="350" width="165" height="115" as="geometry"/></mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;dashed=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v24" value="&lt;b&gt;B-04&lt;/b&gt; Embed chặn event loop → request khác (kể cả health) bị trễ&lt;br&gt;&lt;br&gt;&lt;b&gt;B-09&lt;/b&gt; Load model lỗi bị nuốt; nhiều request load lặp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;spacingRight=6;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="634" y="350" width="165" height="115" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;dashed=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v6" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v26" value="&lt;b&gt;B-08&lt;/b&gt; Lọc category bằng chuỗi ghép kiểu SQL (bị cấm, dễ injection)&lt;br&gt;&lt;br&gt;&lt;b&gt;B-01&lt;/b&gt; Đường dẫn Windows viết cứng → không chạy được trong Docker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;spacingRight=6;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="832" y="350" width="165" height="115" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;dashed=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v28" value="&lt;b&gt;B-05&lt;/b&gt; Khớp tên tác giả bằng chuỗi con: &quot;et al.&quot; khớp MỌI người&lt;br&gt;&lt;br&gt;&lt;b&gt;B-10&lt;/b&gt; Thiếu điểm → tự gán sim = 0,5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;spacingRight=6;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1030" y="350" width="165" height="115" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;dashed=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v30" value="&lt;b&gt;B-02&lt;/b&gt; Nhiều request đồng thời → hết sequence → HTTP 500&lt;br&gt;&lt;br&gt;&lt;b&gt;B-03&lt;/b&gt; Không stream: người dùng chờ tới token cuối cùng&lt;br&gt;&lt;br&gt;&lt;b&gt;B-06&lt;/b&gt; iGPU Intel Arc bị coi là CPU&lt;br&gt;&lt;br&gt;&lt;b&gt;B-07&lt;/b&gt; Sai đường dẫn model → trả câu &quot;fallback&quot; giả với HTTP 200" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;spacingRight=6;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1228" y="350" width="165" height="215" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;dashed=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v9" target="v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v32" value="&lt;b&gt;B-15&lt;/b&gt; authority_score có thể bị thiếu trong JSON&lt;br&gt;&lt;br&gt;&lt;b&gt;B-16&lt;/b&gt; Mô tả cứng 7B / 913k chunk / CUDA, lệch thực tế" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;spacingRight=6;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1624" y="350" width="165" height="115" as="geometry"/></mxCell>
        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;dashed=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v11" target="v32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v34" value="&lt;b&gt;Gốc rễ của vấn đề&lt;/b&gt;&lt;br&gt;• Tất cả chạy trong 1 tiến trình: LLM chiếm CPU/GPU, embed chặn event loop → các request ảnh hưởng lẫn nhau&lt;br&gt;• LLM không có hàng đợi, không stream, không chạy được trên máy khác&lt;br&gt;• Không có metrics / tracing → chưa có số đo performance trước / sau (thầy chấm kỹ phần này)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fdf0ef;strokeColor=#b85450;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="820" height="110" as="geometry"/></mxCell>
        <mxCell id="v35" value="&lt;b&gt;Hướng xử lý&lt;/b&gt; (xem sơ đồ ③ ④ ⑤)&lt;br&gt;1. Đo baseline (M-00), sửa bug ngay trong monolith trước (M-01 → M-04)&lt;br&gt;2. Sau đó tách: gateway · rag · retrieval · llm (rồi auth, chat, paper)&lt;br&gt;3. Thêm hàng đợi LLM, stream SSE, cache Redis, OpenTelemetry để đo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="610" width="830" height="110" as="geometry"/></mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v34" target="v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v37" value="&lt;b&gt;Chú thích:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="80" height="22" as="geometry"/></mxCell>
        <mxCell id="v38" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="125" y="752" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="v39" value="Frontend / kết quả" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="161" y="750" width="129" height="22" as="geometry"/></mxCell>
        <mxCell id="v40" value="" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="304" y="752" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="v41" value="Lớp HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="750" width="63" height="22" as="geometry"/></mxCell>
        <mxCell id="v42" value="" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="417" y="752" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="v43" value="Bước xử lý" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="453" y="750" width="76" height="22" as="geometry"/></mxCell>
        <mxCell id="v44" value="" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="543" y="752" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="v45" value="LLM (nút cổ chai)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="579" y="750" width="123" height="22" as="geometry"/></mxCell>
        <mxCell id="v46" value="" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="716" y="752" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="v47" value="Bug / rủi ro" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="752" y="750" width="90" height="22" as="geometry"/></mxCell>
        <mxCell id="l48" value="" style="html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856" y="761" as="sourcePoint"/><mxPoint x="900" y="761" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v49" value="chạy tuần tự" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="906" y="750" width="90" height="22" as="geometry"/></mxCell>
