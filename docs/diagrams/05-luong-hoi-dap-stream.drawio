        <mxCell id="l38" value="answer.completed (không chờ)" style="html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#10739e;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="1310" as="sourcePoint"/><mxPoint x="1660" y="1310" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l39" value="SET ans: (TTL 1 giờ)" style="html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#8a8a8a;strokeWidth=1.5;dashed=1;dashPattern=2 3;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="1350" as="sourcePoint"/><mxPoint x="880" y="1350" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v40" value="&lt;b&gt;TTFT&lt;/b&gt; (time to first token) = từ lúc gateway nhận request đến lúc ghi event token đầu tiên. Có stream thì TTFT nhỏ hơn nhiều so với chờ cả câu trả lời như hiện tại (B-03)." style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=8;shape=note;size=14;fillColor=#fffbe6;strokeColor=#b3a369;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="540" height="110" as="geometry"/></mxCell>
        <mxCell id="v41" value="&lt;b&gt;Client đóng tab giữa chừng&lt;/b&gt;: gateway gọi call.cancel() → rag huỷ Generate → llm dừng sinh token và trả sequence về hàng đợi. Không tốn GPU cho câu không ai đọc." style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=8;shape=note;size=14;fillColor=#fffbe6;strokeColor=#b3a369;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="1450" width="540" height="110" as="geometry"/></mxCell>
        <mxCell id="v42" value="&lt;b&gt;Lỗi&lt;/b&gt;: xảy ra trước khi gửi header → trả HTTP status (400 / 401 / 429 / 503 / 504). Xảy ra khi đang stream → gửi event: error rồi đóng. Lưu chat lỗi → vẫn trả câu trả lời, persisted = false." style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=8;shape=note;size=14;fillColor=#fffbe6;strokeColor=#b3a369;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="1450" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="v43" value="&lt;b&gt;Chú thích:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1600" width="80" height="22" as="geometry"/></mxCell>
